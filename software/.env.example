# Copy to .env (repository root or map_reflect/). Only needed for runs that call a model.
# ENDPOINT_A: an OpenAI-compatible chat gateway (gpt-oss-120b, Qwen3.5-397B, a copy of Granite-4)
ENDPOINT_A_URL=https://ENDPOINT_A
ENDPOINT_A_API_KEY=replace-me
# ENDPOINT_B: a hosted text-generation service (Llama-4 Maverick, Granite-4)
ENDPOINT_B_URL=https://ENDPOINT_B
ENDPOINT_B_API_KEY=replace-me
ENDPOINT_B_PROJECT_ID=replace-me
# ENDPOINT_C: a LiteLLM gateway, used only for optional frontier-model checks
LITELLM_API_KEY=replace-me
