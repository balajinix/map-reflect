{
  "name": "HCP_TERRAFORM",
  "description": "HashiCorp Terraform Cloud/Enterprise schema",
  "node_types": [
    {
      "name": "ORGANIZATION",
      "description": "Terraform Cloud organization",
      "properties": [
        {"name": "id", "type": "string", "description": "Organization ID"},
        {"name": "name", "type": "string", "description": "Organization name"},
        {"name": "email", "type": "string", "description": "Admin email"},
        {"name": "created_at", "type": "datetime", "description": "Creation timestamp"},
        {"name": "collaborator_count", "type": "integer", "description": "Number of collaborators"}
      ]
    },
    {
      "name": "WORKSPACE",
      "description": "Terraform workspace",
      "properties": [
        {"name": "id", "type": "string", "description": "Workspace ID"},
        {"name": "name", "type": "string", "description": "Workspace name"},
        {"name": "description", "type": "string", "description": "Workspace description"},
        {"name": "auto_apply", "type": "boolean", "description": "Auto-apply enabled"},
        {"name": "terraform_version", "type": "string", "description": "Terraform version"},
        {"name": "resource_count", "type": "integer", "description": "Number of managed resources"},
        {"name": "created_at", "type": "datetime", "description": "Creation timestamp"},
        {"name": "updated_at", "type": "datetime", "description": "Last update timestamp"},
        {"name": "locked", "type": "boolean", "description": "Workspace is locked"},
        {"name": "execution_mode", "type": "string", "description": "remote, local, or agent"}
      ]
    },
    {
      "name": "RUN",
      "description": "Terraform run/execution",
      "properties": [
        {"name": "id", "type": "string", "description": "Run ID"},
        {"name": "status", "type": "string", "description": "Run status"},
        {"name": "is_destroy", "type": "boolean", "description": "Destroy run"},
        {"name": "message", "type": "string", "description": "Run message"},
        {"name": "created_at", "type": "datetime", "description": "Creation timestamp"},
        {"name": "has_changes", "type": "boolean", "description": "Has infrastructure changes"},
        {"name": "resource_additions", "type": "integer", "description": "Resources to add"},
        {"name": "resource_changes", "type": "integer", "description": "Resources to change"},
        {"name": "resource_destructions", "type": "integer", "description": "Resources to destroy"}
      ]
    },
    {
      "name": "STATE_VERSION",
      "description": "Terraform state version",
      "properties": [
        {"name": "id", "type": "string", "description": "State version ID"},
        {"name": "serial", "type": "integer", "description": "State serial number"},
        {"name": "created_at", "type": "datetime", "description": "Creation timestamp"},
        {"name": "size", "type": "integer", "description": "State size in bytes"},
        {"name": "resources_processed", "type": "boolean", "description": "Resources processed flag"}
      ]
    },
    {
      "name": "AGENT_POOL",
      "description": "Terraform Cloud agent pool",
      "properties": [
        {"name": "id", "type": "string", "description": "Agent pool ID"},
        {"name": "name", "type": "string", "description": "Agent pool name"},
        {"name": "created_at", "type": "datetime", "description": "Creation timestamp"},
        {"name": "agent_count", "type": "integer", "description": "Number of agents"},
        {"name": "organization_scoped", "type": "boolean", "description": "Available org-wide"}
      ]
    },
    {
      "name": "VARIABLE",
      "description": "Workspace variable",
      "properties": [
        {"name": "id", "type": "string", "description": "Variable ID"},
        {"name": "key", "type": "string", "description": "Variable key/name"},
        {"name": "value", "type": "string", "description": "Variable value"},
        {"name": "category", "type": "string", "description": "terraform or env"},
        {"name": "sensitive", "type": "boolean", "description": "Is sensitive"},
        {"name": "hcl", "type": "boolean", "description": "Is HCL format"}
      ]
    },
    {
      "name": "TEAM",
      "description": "Organization team",
      "properties": [
        {"name": "id", "type": "string", "description": "Team ID"},
        {"name": "name", "type": "string", "description": "Team name"},
        {"name": "visibility", "type": "string", "description": "secret or organization"},
        {"name": "users_count", "type": "integer", "description": "Number of members"}
      ]
    },
    {
      "name": "POLICY",
      "description": "Sentinel policy",
      "properties": [
        {"name": "id", "type": "string", "description": "Policy ID"},
        {"name": "name", "type": "string", "description": "Policy name"},
        {"name": "description", "type": "string", "description": "Policy description"},
        {"name": "enforcement_level", "type": "string", "description": "hard-mandatory, soft-mandatory, advisory"},
        {"name": "policy_set_count", "type": "integer", "description": "Number of policy sets"}
      ]
    }
  ],
  "edges": [
    {"from_type": "ORGANIZATION", "to_type": "WORKSPACE", "label": "OWNS"},
    {"from_type": "ORGANIZATION", "to_type": "TEAM", "label": "HAS_TEAM"},
    {"from_type": "ORGANIZATION", "to_type": "AGENT_POOL", "label": "MANAGES"},
    {"from_type": "WORKSPACE", "to_type": "RUN", "label": "HAS_RUN"},
    {"from_type": "WORKSPACE", "to_type": "STATE_VERSION", "label": "HAS_STATE"},
    {"from_type": "WORKSPACE", "to_type": "VARIABLE", "label": "HAS_VARIABLE"},
    {"from_type": "RUN", "to_type": "STATE_VERSION", "label": "PRODUCES"},
    {"from_type": "WORKSPACE", "to_type": "AGENT_POOL", "label": "RUNS_ON"},
    {"from_type": "TEAM", "to_type": "WORKSPACE", "label": "HAS_ACCESS"},
    {"from_type": "POLICY", "to_type": "WORKSPACE", "label": "APPLIES_TO"}
  ]
}
